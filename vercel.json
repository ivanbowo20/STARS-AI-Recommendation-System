{
  "version": 2,
  "regions": ["sin1"],
  "cleanUrls": true,
  "functions": {
    "api/*.py": {
      "includeFiles": "model/**,templates/**,dataset/**,services/**,api.py",
      "excludeFiles": "public/**,assets/**,docs/**,graphify-out/**,training/**",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/dataset/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp|webm|mp4|woff2|woff|csv)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/kontak", "destination": "/kontak.html" },
    { "source": "/api/prediksi", "destination": "/api/prediksi.py" },
    { "source": "/api/contact", "destination": "/api/contact.py" }
  ]
}
